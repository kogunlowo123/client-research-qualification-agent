# Copy to .env for local runs. Only non-secret settings belong here; secrets
# come from Databricks unified auth (CLI profile, OAuth, OIDC) or a secret scope.

# Environment overlay: local | dev | staging | prod
CRA_ENVIRONMENT=local

# Databricks workspace URL (required for dev/staging/prod runs)
DATABRICKS_HOST=
# Databricks CLI profile used for OAuth user-to-machine login (databricks auth login)
DATABRICKS_CONFIG_PROFILE=

# Unity Catalog location overrides (defaults come from config/environments/*.yaml)
CRA_DATABRICKS__CATALOG=client_research
CRA_DATABRICKS__SCHEMA=agent_local
# Serverless SQL warehouse id used for Delta reads/writes
CRA_DATABRICKS__WAREHOUSE_ID=

# Vector Search endpoint name
CRA_VECTOR_SEARCH__ENDPOINT_NAME=cra-vs-endpoint-dev

# Contact address sent in the crawler User-Agent (SEC EDGAR fair-access policy)
CRA_CRAWLER__CONTACT_EMAIL=

# Observability
CRA_OBSERVABILITY__LOG_LEVEL=INFO
CRA_OBSERVABILITY__JSON_LOGS=false
# OTLP/HTTP collector, e.g. http://localhost:4318 with docker compose
CRA_OBSERVABILITY__OTLP_ENDPOINT=
# MLflow tracking server, e.g. http://localhost:5000 with docker compose, or "databricks"
MLFLOW_TRACKING_URI=
